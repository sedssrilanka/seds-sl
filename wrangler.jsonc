{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seds-sl",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SERVER_URL": "https://sedssl.org"
  },
  "observability": {
    "enabled": true
  }
}
