# Resend API Key for email sending
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Configuration
# The email address that will receive contact form submissions
CONTACT_EMAIL=contact@seds-sl.org

# The email address that will appear as the sender
# This must be a verified domain in Resend
FROM_EMAIL=noreply@seds-sl.org

# Organization name for email templates
ORG_NAME=SEDS Sri Lanka

# Website URL for email templates
WEBSITE_URL=https://seds-sl.org

PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET_HERE
DATABASE_URI=postgresql://user:password@host:port/database_name

# Storage Adapter: "s3" or "vercel-blob"
STORAGE_ADAPTER=s3

# Vercel Blob configuration (required if STORAGE_ADAPTER=vercel-blob)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# S3 Storage configuration (required if STORAGE_ADAPTER=s3)
S3_BUCKET=site-base
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
S3_REGION=ap-southeast-1
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3


PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host.example